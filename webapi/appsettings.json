{
  
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://localhost:3000"
      },
      "Https": {
        "Url": "https://localhost:3001"
      }
    }
  },

  "Database": {
    "Provider": "sqlite",
    "Sqlite": {
      "ConnectionString": "Data Source=hanjian.db"
    }
  },
  "Jwt": {
    "SecretKey": "HanJianNet-2026-Please-Change-This-Long-Secret-Key-In-Production",
    "Issuer": "HanJianNet",
    "Audience": "HanJianNet",
    "ExpireMinutes": 1440
  },
  "Uploads": {
    "MaxBytes": 10485760,
    "AllowedTypes": [".jpg", ".jpeg", ".png", ".webp", ".pdf"]
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:3000"
    ]
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminEmail": "admin@hanjiannet.local",
    "AdminPassword": "admin123456",
    "TestUsers": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "Path": "logs/hanjian-.log",
          "RollingInterval": "Day",
          "RetainedFileCountLimit": 30,
          "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
